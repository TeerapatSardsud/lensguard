# Copy to .env (git-ignored) and fill in. Never commit .env, never paste these in chat.
# Gateway device (used by tools/mqtt_simulator.py, which pretends to be the gateway)
NETPIE_CLIENT_ID=
NETPIE_TOKEN=
NETPIE_SECRET=
# Second NETPIE device in the SAME device group, used by ai/service.py
AI_NETPIE_CLIENT_ID=
AI_NETPIE_TOKEN=
AI_NETPIE_SECRET=
# Telegram (tools/telegram_test.py header explains how to get them)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# OTA password for `pio run -d gateway -e gateway_ota -t upload` (same as OTA_PASSWORD in secrets.h)
LENSGUARD_OTA_PASSWORD=
